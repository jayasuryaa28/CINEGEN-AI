# CINEGEN AI — Environment Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env

PORT=3000
NODE_ENV=production

# Storage paths
STORAGE_LOCAL_DIR=./storage_data
TEMP_UPLOAD_DIR=./storage_data/uploads
PROCESSED_VIDEO_DIR=./storage_data/processed

# Security & Encryption (Derives AES-256-GCM key for encrypting user cloud API keys)
# Generate a strong 32+ character random secret for production use:
ENCRYPTION_SECRET=change-this-to-a-secure-random-32-char-secret-key-in-production

# Optional: Cloud GPU Remote Worker Bridge (For Mode A remote worker nodes)
# CLOUD_WORKER_ENDPOINT=https://your-cloud-worker:8000
# CLOUD_WORKER_TOKEN=your-remote-bridge-token
# CLOUD_WORKER_TIMEOUT_MS=60000

# Redis configuration (Optional: automatically activates in-memory worker queue if unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379

# Database configuration (Defaults to local JSON file repository)
USE_LOCAL_DB_STORE=true
# DATABASE_URL=postgresql://user:password@localhost:5432/cinegen
